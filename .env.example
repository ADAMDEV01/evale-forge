# Application
VITE_API_URL=http://localhost:8000/api

# Backend
FASTAPI_ENV=development
DATABASE_URL=sqlite:///./evalforge.db
# Production requires FASTAPI_ENV=production and a persistent PostgreSQL URL.
# Keep database credentials in deployment secrets; see DEPLOYMENT.md.
# Hosted PostgreSQL example; keep credentials in deployment secrets:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/evalforge
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# Optional hosted Groq provider (free plan has model-specific rate limits).
# Set GROQ_API_KEY only in your local .env or Vercel Environment Variables.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
# Optional per-million token rates in USD; set to the current model's published rates.
GROQ_INPUT_COST_PER_MILLION=
GROQ_OUTPUT_COST_PER_MILLION=

# Backend authentication; provide a unique random value of at least 32 bytes.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

JWT_SECRET_KEY=
# Set true when serving over HTTPS; false is for local HTTP development only.
AUTH_COOKIE_SECURE=false
# Comma-separated explicit browser origins; wildcard origins are not accepted.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
